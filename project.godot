; Engine configuration file.
config_version=5

[application]

config/name="Truffe & Co"
config/description="Truffe & Co – compagnons virtuels"
config/version="2.4.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icons/icon.png"
run/low_processor_mode=false
boot_splash/bg_color=Color(0.99, 0.77, 0.55, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/icons/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
config/quit_on_go_back=false
config/auto_accept_quit=false

[audio]

driver/enable_input=true
driver/mix_rate=44100
driver/mix_rate.mobile=44100
driver/output_latency=30
driver/output_latency.mobile=60
general/default_playback_type.mobile=0

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
GameState="*res://scripts/autoload/game_state.gd"
Audio="*res://scripts/autoload/audio.gd"
Voice="*res://scripts/autoload/voice.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://translations/strings.fr.translation")
locale/test="fr"
locale/fallback="fr"

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.7, 0.85, 0.95, 1)
